NODE_ENV=production
PORT=3000
ADMIN_EMAIL=admin@lgy.fr
# Générez la valeur avec : npm run hash-password -- "votre-mot-de-passe-fort"
ADMIN_PASSWORD_HASH=scrypt$REMPLACER$REMPLACER$64
# Au moins 32 octets aléatoires. Exemple : openssl rand -base64 48
TOKEN_SECRET=remplacez-par-une-cle-aleatoire-longue-et-unique
# Nom(s) d'hôte autorisé(s), séparés par des virgules
ALLOWED_HOSTS=lgy.fr,www.lgy.fr
# Activez uniquement derrière un reverse proxy de confiance (Railway, Nginx configuré)
TRUST_PROXY=1
