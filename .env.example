NODE_ENV=production
PORT=3000
APP_URL=https://www.hygiesafe.com
PUBLIC_SITE_URL=https://www.hygiesafe.com
# Railway fournit généralement cette variable automatiquement (ex: xxx.up.railway.app)
RAILWAY_PUBLIC_DOMAIN=
DATABASE_URL=postgresql://user:password@host:5432/hygiesafe
DATABASE_SSL=false
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
TRUSTED_SESSION_DAYS=30
# 32+ octets aléatoires, utilisé pour chiffrer les secrets 2FA au repos
# Exemple de génération : openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Compte super-admin initial (utilisé uniquement par scripts/seed-admin.js)
ADMIN_EMAIL=admin@hygiesafe.com
ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
# Tarif B2B affiché 9,99 € HT : activer Stripe Tax avant production
STRIPE_AUTOMATIC_TAX=true
STRIPE_PRICE_TAX_BEHAVIOR=exclusive
STRIPE_COLLECT_TAX_ID=true

# E-mails transactionnels — Resend recommandé
# Créez une clé d'envoi Resend et vérifiez votre domaine avant la production.
RESEND_API_KEY=
RESEND_FROM=HygieSafe <noreply@mail.hygiesafe.com>

# Recherche de produits par code-barres (activée par défaut)
PRODUCT_LOOKUP_OPENFOODFACTS=true
PRODUCT_LOOKUP_UPCITEMDB=true
PRODUCT_LOOKUP_TIMEOUT_MS=4500
# Facultatif : compte UPCitemdb DEV/PRO. Sans clé, HygieSafe utilise l'API Trial (quota limité).
UPCITEMDB_USER_KEY=
UPCITEMDB_KEY_TYPE=3scale

# SMTP de secours (facultatif). Utilisé uniquement si RESEND_API_KEY est vide.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HygieSafe <noreply@mail.hygiesafe.com>

# Stockage persistant — choisir S3 OU un Railway Volume
# Avec un Volume Railway monté par exemple sur /data :
UPLOAD_DIR=/data/uploads

# Stockage objet S3 compatible (Railway bucket, AWS S3, Scaleway, etc.)
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Juridique - à renseigner avant commercialisation
LEGAL_COMPANY_NAME=LIVRICI SOLUTIONS SAS
LEGAL_FORM=SAS - société par actions simplifiée
LEGAL_CAPITAL=2,00 €
LEGAL_SIREN=100 815 471
LEGAL_SIRET=100 815 471 00014
LEGAL_RCS=100 815 471 RCS Vannes
LEGAL_RNE=SIREN 100 815 471
LEGAL_VAT=FR37100815471
LEGAL_NAF=62.01Z - Programmation informatique
LEGAL_ADDRESS=LOT 4 ZAC DES HAMEAUX VERTS 5 RUE DES TULIPIERS 56250 LA VRAIE-CROIX
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_PUBLISHER=
LEGAL_HOST_NAME=Railway Corporation
LEGAL_HOST_ADDRESS=548 Market St PMB 68956, San Francisco, CA 94104, États-Unis
LEGAL_HOST_PHONE=+1 415 707 7675
LEGAL_PRIVACY_EMAIL=
